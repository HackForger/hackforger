					<span class="help">{{ctx.Locale.Tr "repo.settings.event_action_success_desc"}}</span>
				</label>
			</fieldset>
			<!-- HackForger Events -->
			<fieldset class="simple-grid grid-2">
				<legend>{{ctx.Locale.Tr "repo.settings.event_header_hackforger"}}</legend>
				<!-- Hackathon Events -->
				<label>
					<input name="hackathon_created" type="checkbox" {{if .Webhook.HackathonCreated}}checked{{end}}>
