{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content explore">
	{{template "explore/navbar" .}}
	<div class="ui container">
		{{template "hackforger/explore_search" .}}

		{{if .Bounties}}
		<div class="hf-card">
			{{range .Bounties}}
			<div class="hf-row">
				<div class="hf-row-left">
					<div>
						<a class="tw-text-lg tw-font-semibold" href="{{.IssueLink}}">{{.Title}}</a>
						<div class="tw-text-sm tw-text-gray tw-mb-1">{{.RepoFullName}} #{{.IssueIndex}}</div>
					</div>
				</div>
				<div class="tw-flex tw-items-center tw-gap-2">
					{{template "hackforger/helpers/status_badge" dict "Type" "bounty" "Status" .Status "Label" (Iif (eq .Status 0) (ctx.Locale.Tr "hackforger.bounty.status.open") (Iif (eq .Status 1) (ctx.Locale.Tr "hackforger.bounty.status.claimed") (Iif (eq .Status 2) (ctx.Locale.Tr "hackforger.bounty.status.in_review") (Iif (eq .Status 3) (ctx.Locale.Tr "hackforger.bounty.status.completed") (Iif (eq .Status 4) (ctx.Locale.Tr "hackforger.bounty.status.paid") (Iif (eq .Status 5) (ctx.Locale.Tr "hackforger.bounty.status.expired") (ctx.Locale.Tr "hackforger.bounty.status.cancelled")))))))}}
					{{if .Mode}}
						<span class="hf-badge hf-badge-neutral">{{ctx.Locale.Tr "hackforger.bounty.mode.competitive"}}</span>
					{{else}}
						<span class="hf-badge hf-badge-neutral">{{ctx.Locale.Tr "hackforger.bounty.mode.exclusive"}}</span>
					{{end}}
				</div>
			</div>
			{{end}}
		</div>
		{{template "base/paginate" .}}
		{{else}}
		<div class="hf-card">
			<div class="hf-empty">
				{{svg "octicon-gift" 48}}
				<br>
				{{ctx.Locale.Tr "hackforger.bounty.explore.empty"}}
			</div>
		</div>
		{{end}}
	</div>
</div>
{{template "base/footer" .}}
