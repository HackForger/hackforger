{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content explore">
	{{template "explore/navbar" .}}
	<div class="ui container">
		{{if .PageIsExploreHackathons}}
		<h2>{{ctx.Locale.Tr "hackforger.explore.hackathons"}}</h2>
		{{if .Hackathons}}
		<div class="hf-card">
			{{range .Hackathons}}
			<div class="hf-row">
				<div class="hf-row-left">
					<div>
						<a class="tw-text-lg tw-font-medium" href="{{AppSubUrl}}/hackathon/{{.Slug}}">{{.Name}}</a>
						{{if .Description}}<div class="tw-text-sm tw-text-gray tw-mt-1">{{.Description}}</div>{{end}}
					</div>
				</div>
				{{template "hackforger/helpers/status_badge" dict "Type" "hackathon" "Status" .Status "Label" (Iif (eq .Status 0) "Draft" (Iif (eq .Status 1) "Open" (Iif (eq .Status 2) "Hacking" (Iif (eq .Status 3) "Judging" (Iif (eq .Status 4) "Finished" "Cancelled")))))}}
			</div>
			{{end}}
		</div>
		{{else}}
		<p>{{ctx.Locale.Tr "hackforger.hackathon.no_hackathons"}}</p>
		{{end}}
		{{else if .PageIsExploreBounties}}
		<h2>{{ctx.Locale.Tr "hackforger.explore.bounties"}}</h2>
		<p>{{ctx.Locale.Tr "hackforger.explore.coming_soon"}}</p>
		{{else if .PageIsExploreGrants}}
		<h2>{{ctx.Locale.Tr "hackforger.explore.grants"}}</h2>
		<p>{{ctx.Locale.Tr "hackforger.explore.coming_soon"}}</p>
		{{end}}
	</div>
</div>
{{template "base/footer" .}}
