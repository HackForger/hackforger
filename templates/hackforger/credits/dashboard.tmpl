{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content user">
	<div class="ui container">
		<h2 class="ui header">
			{{svg "octicon-credit-card" 24}} {{ctx.Locale.Tr "hackforger.credits.title"}}
		</h2>

		<div class="ui segment">
			<div class="ui statistic">
				<div class="value">{{.Balance}}</div>
				<div class="label">{{ctx.Locale.Tr "hackforger.credits.balance"}}</div>
			</div>
		</div>

		<h3 class="ui header">{{ctx.Locale.Tr "hackforger.credits.transactions"}}</h3>
		{{if .Transactions}}
		<table class="ui celled table">
			<thead>
				<tr>
					<th>{{ctx.Locale.Tr "hackforger.credits.type"}}</th>
					<th>{{ctx.Locale.Tr "hackforger.credits.amount"}}</th>
					<th>{{ctx.Locale.Tr "hackforger.credits.balance_after"}}</th>
					<th>{{ctx.Locale.Tr "hackforger.credits.reference"}}</th>
					<th>{{ctx.Locale.Tr "hackforger.credits.note"}}</th>
				</tr>
			</thead>
			<tbody>
				{{range .Transactions}}
				<tr>
					<td>{{.Type}}</td>
					<td>{{if gt .Amount 0}}<span class="tw-text-green">+{{.Amount}}</span>{{else}}<span class="tw-text-red">{{.Amount}}</span>{{end}}</td>
					<td>{{.Balance}}</td>
					<td>{{.Reference}}</td>
					<td>{{.Note}}</td>
				</tr>
				{{end}}
			</tbody>
		</table>
		{{else}}
		<div class="ui placeholder segment">
			<div class="ui icon header">
				{{svg "octicon-credit-card" 48}}
				<br>
				{{ctx.Locale.Tr "hackforger.credits.no_transactions"}}
			</div>
		</div>
		{{end}}
	</div>
</div>
{{template "base/footer" .}}
