{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content">
	<div class="ui container">
		<h2>
			<a href="/grants/{{.Round.Slug}}/manage">{{.Round.Name}}</a>
			&mdash; {{.Project.Title}}
		</h2>

		{{template "base/alert" .}}

		<div class="hf-card">
			<div class="hf-card-body">
				<div class="tw-mb-2">
					<strong>{{ctx.Locale.Tr "hackforger.grant.project.title"}}:</strong> {{.Project.Title}}
				</div>
				<div class="tw-mb-2">
					<strong>{{ctx.Locale.Tr "hackforger.grant.project.user"}}:</strong> {{.Project.UserID}}
				</div>
				<div class="tw-mb-2">
					<strong>{{ctx.Locale.Tr "hackforger.grant.status"}}:</strong>
					{{template "hackforger/helpers/status_badge" dict "Type" "grant_project" "Status" .Project.Status "Label" (Iif (eq .Project.Status 0) "pending" (Iif (eq .Project.Status 1) "approved" (Iif (eq .Project.Status 2) "rejected" "funded")))}}
				</div>
				{{if .Project.Description}}
					<div class="tw-mb-2">
						<strong>{{ctx.Locale.Tr "hackforger.grant.project.description"}}:</strong>
						<p>{{.Project.Description}}</p>
					</div>
				{{end}}
				{{if gt .Project.RepoID 0}}
					<div class="tw-mb-2">
						<strong>{{ctx.Locale.Tr "hackforger.grant.project.repo_id"}}:</strong> {{.Project.RepoID}}
					</div>
				{{end}}
				<div class="tw-mb-2">
					<strong>{{ctx.Locale.Tr "hackforger.grant.project.award"}}:</strong>
					{{.Project.AwardAmount}} + {{.Project.AwardCredits}} {{ctx.Locale.Tr "hackforger.credits"}}
				</div>
			</div>
		</div>

		{{/* Action buttons based on project status */}}
		{{if eq .Project.Status 0}}
			<div class="hf-card">
				<div class="hf-card-head">
					<span>{{ctx.Locale.Tr "hackforger.grant.project.review_actions"}}</span>
				</div>
				<div class="hf-card-body">
					<div class="tw-flex tw-gap-2">
						<form action="/grants/{{.Round.Slug}}/manage/projects/{{.Project.ID}}/approve" method="post" class="tw-inline">
							<button class="hf-btn hf-btn-primary">{{ctx.Locale.Tr "hackforger.grant.project.approve"}}</button>
						</form>
						<form action="/grants/{{.Round.Slug}}/manage/projects/{{.Project.ID}}/reject" method="post" class="tw-inline">
							<button class="hf-btn hf-btn-danger">{{ctx.Locale.Tr "hackforger.grant.project.reject"}}</button>
						</form>
					</div>
				</div>
			</div>
		{{end}}

		{{if eq .Project.Status 1}}
			{{/* Approved - can set award and distribute */}}
			<div class="hf-card">
				<div class="hf-card-head">
					<span>{{ctx.Locale.Tr "hackforger.grant.project.set_award"}}</span>
				</div>
				<div class="hf-card-body">
					<form class="ui form" action="/grants/{{.Round.Slug}}/manage/projects/{{.Project.ID}}/award" method="post">
						<div class="two fields">
							<div class="field">
								<label>{{ctx.Locale.Tr "hackforger.grant.project.award_amount"}}</label>
								<input type="number" name="award_amount" step="0.01" min="0" value="{{.Project.AwardAmount}}">
							</div>
							<div class="field">
								<label>{{ctx.Locale.Tr "hackforger.grant.project.award_credits"}}</label>
								<input type="number" name="award_credits" min="0" value="{{.Project.AwardCredits}}">
							</div>
						</div>
						<button class="hf-btn hf-btn-primary">{{ctx.Locale.Tr "hackforger.grant.project.save_award"}}</button>
					</form>
				</div>
			</div>

			{{if eq .Round.Status 3}}
				<div class="hf-card">
					<div class="hf-card-head">
						<span>{{ctx.Locale.Tr "hackforger.grant.project.distribute"}}</span>
					</div>
					<div class="hf-card-body">
						<form action="/grants/{{.Round.Slug}}/manage/projects/{{.Project.ID}}/distribute" method="post">
							<button class="hf-btn hf-btn-primary">{{ctx.Locale.Tr "hackforger.grant.project.distribute"}}</button>
						</form>
					</div>
				</div>
			{{end}}
		{{end}}

		<div class="tw-mt-4">
			<a class="hf-btn hf-btn-secondary" href="/grants/{{.Round.Slug}}/manage">{{ctx.Locale.Tr "hackforger.grant.back_to_manage"}}</a>
		</div>
	</div>
</div>
{{template "base/footer" .}}
