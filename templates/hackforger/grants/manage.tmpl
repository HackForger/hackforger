{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content">
	<div class="ui container">
		<h2>
			{{ctx.Locale.Tr "hackforger.grant.manage"}}
			&mdash; <a href="/grants/{{.Round.Slug}}">{{.Round.Name}}</a>
		</h2>

		{{template "base/alert" .}}

		{{/* Status and action buttons */}}
		<div class="ui segment">
			<div class="tw-flex tw-items-center tw-gap-4 tw-mb-4">
				<span class="ui large label">{{.StatusName}}</span>
				<div class="tw-flex tw-gap-2">
					{{if eq .Round.Status 0}}
						<form action="/grants/{{.Round.Slug}}/manage/open" method="post" class="tw-inline">
							<button class="ui green button">{{ctx.Locale.Tr "hackforger.grant.action.open"}}</button>
						</form>
					{{end}}
					{{if eq .Round.Status 1}}
						<form action="/grants/{{.Round.Slug}}/manage/close" method="post" class="tw-inline">
							<button class="ui yellow button">{{ctx.Locale.Tr "hackforger.grant.action.close"}}</button>
						</form>
					{{end}}
					{{if eq .Round.Status 2}}
						<form action="/grants/{{.Round.Slug}}/manage/finalize" method="post" class="tw-inline">
							<button class="ui blue button">{{ctx.Locale.Tr "hackforger.grant.action.finalize"}}</button>
						</form>
					{{end}}
					{{if eq .Round.Status 3}}
						<form action="/grants/{{.Round.Slug}}/manage/distribute" method="post" class="tw-inline">
							<button class="ui primary button">{{ctx.Locale.Tr "hackforger.grant.action.distribute"}}</button>
						</form>
					{{end}}
					{{if and (ne .Round.Status 4) (ne .Round.Status 5)}}
						<form action="/grants/{{.Round.Slug}}/manage/cancel" method="post" class="tw-inline">
							<button class="ui red button">{{ctx.Locale.Tr "hackforger.grant.action.cancel"}}</button>
						</form>
					{{end}}
				</div>
			</div>

			{{/* Budget usage */}}
			<div class="tw-mb-4">
				<h4>{{ctx.Locale.Tr "hackforger.grant.round.budget_usage"}}</h4>
				{{if gt .Round.Budget 0.0}}
					<div class="tw-mb-2">
						<strong>{{.Round.Currency}}:</strong> {{.UsedAmount}} / {{.Round.Budget}}
					</div>
				{{end}}
				{{if gt .Round.BudgetCredits 0}}
					<div class="tw-mb-2">
						<strong>{{ctx.Locale.Tr "hackforger.credits"}}:</strong> {{.UsedCredits}} / {{.Round.BudgetCredits}}
					</div>
				{{end}}
			</div>

			<a class="ui button" href="/grants/{{.Round.Slug}}/export">{{ctx.Locale.Tr "hackforger.grant.export_csv"}}</a>
		</div>

		{{/* Projects table */}}
		<h3>{{ctx.Locale.Tr "hackforger.grant.projects"}}</h3>
		{{if .Projects}}
			<table class="ui striped table">
				<thead>
					<tr>
						<th>ID</th>
						<th>{{ctx.Locale.Tr "hackforger.grant.project.title"}}</th>
						<th>{{ctx.Locale.Tr "hackforger.grant.project.user"}}</th>
						<th>{{ctx.Locale.Tr "hackforger.grant.status"}}</th>
						<th>{{ctx.Locale.Tr "hackforger.grant.project.award"}}</th>
						<th>{{ctx.Locale.Tr "hackforger.grant.actions"}}</th>
					</tr>
				</thead>
				<tbody>
					{{range .Projects}}
						<tr>
							<td>{{.ID}}</td>
							<td><a href="/grants/{{$.Round.Slug}}/manage/projects/{{.ID}}">{{.Title}}</a></td>
							<td>{{.UserID}}</td>
							<td>
								<span class="ui label {{if eq .Status 0}}grey{{else if eq .Status 1}}green{{else if eq .Status 2}}red{{else if eq .Status 3}}blue{{end}}">
									{{if eq .Status 0}}pending{{else if eq .Status 1}}approved{{else if eq .Status 2}}rejected{{else if eq .Status 3}}funded{{end}}
								</span>
							</td>
							<td>
								{{if or (gt .AwardAmount 0.0) (gt .AwardCredits 0)}}
									{{.AwardAmount}} + {{.AwardCredits}} cr
								{{else}}
									&mdash;
								{{end}}
							</td>
							<td>
								<a class="ui mini button" href="/grants/{{$.Round.Slug}}/manage/projects/{{.ID}}">
									{{ctx.Locale.Tr "hackforger.grant.manage"}}
								</a>
							</td>
						</tr>
					{{end}}
				</tbody>
			</table>
		{{else}}
			<div class="ui placeholder segment">
				<div class="ui icon header">
					{{svg "octicon-project" 48}}
					<br>
					{{ctx.Locale.Tr "hackforger.grant.no_projects"}}
				</div>
			</div>
		{{end}}
	</div>
</div>
{{template "base/footer" .}}
