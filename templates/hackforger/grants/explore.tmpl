{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content explore">
	{{template "explore/navbar" .}}
	<div class="ui container">
		<h2>{{ctx.Locale.Tr "hackforger.explore.grants"}}</h2>

		<form class="ui form tw-mb-4" method="get" action="/explore/grants">
			<div class="ui fluid action input">
				<input name="q" type="text" placeholder="{{ctx.Locale.Tr "search"}}..." value="{{.Keyword}}">
				{{if .StatusFilter}}<input type="hidden" name="status" value="{{.StatusFilter}}">{{end}}
				<input type="hidden" name="sort" value="{{.SortType}}">
				<button class="ui primary button" type="submit">{{ctx.Locale.Tr "search"}}</button>
			</div>
		</form>

		<div class="ui secondary menu">
			<a class="item{{if not .StatusFilter}} active{{end}}" href="/explore/grants?q={{.Keyword}}&sort={{.SortType}}">{{ctx.Locale.Tr "all"}}</a>
			{{range $status, $name := .GrantRoundStatusNames}}
				<a class="item{{if eq $.StatusFilter $name}} active{{end}}" href="/explore/grants?q={{$.Keyword}}&sort={{$.SortType}}&status={{$name}}">{{$name}}</a>
			{{end}}

			<div class="right menu">
				<div class="ui dropdown item">
					{{ctx.Locale.Tr "repo.issues.filter_sort"}}
					{{svg "octicon-triangle-down"}}
					<div class="menu">
						<a class="item{{if eq .SortType "newest"}} active{{end}}" href="/explore/grants?q={{.Keyword}}&status={{.StatusFilter}}&sort=newest">{{ctx.Locale.Tr "repo.issues.filter_sort.newest"}}</a>
						<a class="item{{if eq .SortType "oldest"}} active{{end}}" href="/explore/grants?q={{.Keyword}}&status={{.StatusFilter}}&sort=oldest">{{ctx.Locale.Tr "repo.issues.filter_sort.oldest"}}</a>
						<a class="item{{if eq .SortType "mostfunded"}} active{{end}}" href="/explore/grants?q={{.Keyword}}&status={{.StatusFilter}}&sort=mostfunded">{{ctx.Locale.Tr "hackforger.grant.sort.most_funded"}}</a>
						<a class="item{{if eq .SortType "alphabetical"}} active{{end}}" href="/explore/grants?q={{.Keyword}}&status={{.StatusFilter}}&sort=alphabetical">{{ctx.Locale.Tr "hackforger.grant.sort.alphabetical"}}</a>
					</div>
				</div>
			</div>
		</div>

		{{if .Rounds}}
			<div class="ui three stackable cards">
				{{range .Rounds}}
					<div class="ui card">
						<div class="content">
							<div class="header">
								<a href="/grants/{{.Slug}}">{{.Name}}</a>
							</div>
							<div class="meta">
								<span class="ui label {{if eq .Status 1}}green{{else if eq .Status 0}}grey{{else if eq .Status 5}}red{{else}}blue{{end}}">
									{{index $.GrantRoundStatusNames .Status}}
								</span>
							</div>
							<div class="description">
								{{if .Description}}{{.Description}}{{end}}
							</div>
						</div>
						<div class="extra content">
							<span>{{ctx.Locale.Tr "hackforger.grant.budget"}}: {{.Budget}} {{.Currency}}</span>
							{{if gt .BudgetCredits 0}}
								<span class="tw-ml-2">+ {{.BudgetCredits}} {{ctx.Locale.Tr "hackforger.credits"}}</span>
							{{end}}
						</div>
					</div>
				{{end}}
			</div>
		{{else}}
			<div class="ui placeholder segment">
				<div class="ui icon header">
					{{svg "octicon-gift" 48}}
					<br>
					{{ctx.Locale.Tr "hackforger.grant.no_rounds"}}
				</div>
			</div>
		{{end}}

		{{if gt .Total 20}}
			<div class="tw-flex tw-justify-center tw-mt-4">
				{{if gt .Page 1}}
					<a class="ui button" href="/explore/grants?page={{.PrevPage}}{{if .StatusFilter}}&status={{.StatusFilter}}{{end}}&q={{.Keyword}}&sort={{.SortType}}">{{ctx.Locale.Tr "repo.issues.previous"}}</a>
				{{end}}
				<a class="ui button" href="/explore/grants?page={{.NextPage}}{{if .StatusFilter}}&status={{.StatusFilter}}{{end}}&q={{.Keyword}}&sort={{.SortType}}">{{ctx.Locale.Tr "repo.issues.next"}}</a>
			</div>
		{{end}}
	</div>
</div>
{{template "base/footer" .}}
