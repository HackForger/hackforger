{{template "base/head" .}}
<div role="main" aria-label="{{.Hackathon.Name}}" class="page-content hackathon">
	<div class="ui container">
		{{/* Header */}}
		<div class="tw-flex tw-items-center tw-justify-between tw-mb-4">
			<div>
				<h1 class="tw-mb-1">{{.Hackathon.Name}}</h1>
				<div class="tw-flex tw-items-center tw-gap-2">
					<span class="ui label {{if eq .Hackathon.Status 1}}green{{else if eq .Hackathon.Status 2}}blue{{else if eq .Hackathon.Status 3}}orange{{else if eq .Hackathon.Status 4}}grey{{end}}">
						{{.StatusLabel}}
					</span>
					{{if .Owner}}
					<span class="tw-text-sm tw-text-gray">{{ctx.Locale.Tr "hackforger.hackathon.view.organizer"}}: <a href="{{AppSubUrl}}/{{.Owner.Name}}">{{.Owner.Name}}</a></span>
					{{end}}
					{{if .LinkedOrg}}
					<span class="tw-text-sm tw-text-gray">{{ctx.Locale.Tr "hackforger.hackathon.view.org"}}: <a href="{{AppSubUrl}}/{{.LinkedOrg.Name}}">{{svg "octicon-organization" 14}} {{.LinkedOrg.Name}}</a></span>
					{{end}}
				</div>
			</div>
			<div class="tw-flex tw-gap-2">
				{{if .IsOwner}}<a class="ui button" href="{{AppSubUrl}}/hackathon/{{.Hackathon.Slug}}/manage">{{svg "octicon-gear" 14}} {{ctx.Locale.Tr "hackforger.hackathon.manage"}}</a>{{end}}
				{{if .IsJudge}}<a class="ui orange button" href="{{AppSubUrl}}/hackathon/{{.Hackathon.Slug}}/judge">{{svg "octicon-checklist" 14}} {{ctx.Locale.Tr "hackforger.hackathon.judge"}}</a>{{end}}
			</div>
		</div>

		{{/* Timeline */}}
		{{if or .Hackathon.RegistrationEnd .Hackathon.HackingEnd .Hackathon.JudgingEnd}}
		<div class="ui segment">
			<h3>{{svg "octicon-clock" 16}} {{ctx.Locale.Tr "hackforger.hackathon.view.timeline"}}</h3>
			<div class="ui three column grid">
				{{if .Hackathon.RegistrationEnd}}<div class="column"><div class="tw-text-sm tw-font-semibold">{{ctx.Locale.Tr "hackforger.hackathon.view.registration_end"}}</div><div>{{DateUtils.AbsoluteShort .Hackathon.RegistrationEnd}}</div></div>{{end}}
				{{if .Hackathon.HackingEnd}}<div class="column"><div class="tw-text-sm tw-font-semibold">{{ctx.Locale.Tr "hackforger.hackathon.view.hacking_end"}}</div><div>{{DateUtils.AbsoluteShort .Hackathon.HackingEnd}}</div></div>{{end}}
				{{if .Hackathon.JudgingEnd}}<div class="column"><div class="tw-text-sm tw-font-semibold">{{ctx.Locale.Tr "hackforger.hackathon.view.judging_end"}}</div><div>{{DateUtils.AbsoluteShort .Hackathon.JudgingEnd}}</div></div>{{end}}
			</div>
		</div>
		{{end}}

		{{/* Description */}}
		{{if .Hackathon.Description}}
		<div class="ui segment"><p>{{.Hackathon.Description}}</p></div>
		{{end}}

		{{/* Prizes */}}
		{{if .Hackathon.PrizeSummary}}
		<div class="ui segment">
			<h3>{{svg "octicon-gift" 16}} {{ctx.Locale.Tr "hackforger.hackathon.view.prizes"}}</h3>
			<p>{{.Hackathon.PrizeSummary}}</p>
		</div>
		{{end}}

		{{/* Tracks */}}
		{{if .Tracks}}
		<div class="ui segment">
			<h3>{{svg "octicon-tag" 16}} {{ctx.Locale.Tr "hackforger.hackathon.manage.tracks"}} ({{len .Tracks}})</h3>
			<div class="ui divided list">
				{{range .Tracks}}
				<div class="item">
					<div class="content tw-flex tw-items-center tw-justify-between">
						<div>
							<div class="header">{{.Name}}</div>
							{{if .Description}}<div class="description">{{.Description}}</div>{{end}}
						</div>
						{{if .RepoID}}{{$repoName := index $.TrackRepoNames .ID}}<a class="ui mini button" href="{{AppSubUrl}}/{{$.LinkedOrg.Name}}/{{$repoName}}">{{svg "octicon-repo" 14}} {{ctx.Locale.Tr "hackforger.hackathon.view.code"}}</a>{{end}}
					</div>
				</div>
				{{end}}
			</div>
		</div>
		{{end}}

		{{/* Registration CTA */}}
		{{if and (eq .Hackathon.Status 1) .SignedUserID (not .IsRegistered)}}
		<div class="ui segment">
			<h3>{{svg "octicon-person-add" 16}} {{ctx.Locale.Tr "hackforger.hackathon.register"}}</h3>
			<form method="post" action="{{AppSubUrl}}/hackathon/{{.Hackathon.Slug}}/register" class="ui form">
				<div class="field">
					<label>{{ctx.Locale.Tr "hackforger.hackathon.register.mode"}}</label>
					<select name="org_id" class="ui dropdown">
						<option value="0">{{ctx.Locale.Tr "hackforger.hackathon.register.solo"}}</option>
						{{range .UserOrgs}}
						<option value="{{.ID}}">{{.Name}} ({{ctx.Locale.Tr "hackforger.hackathon.register.team"}})</option>
						{{end}}
					</select>
				</div>
				<div class="field">
					<label>{{ctx.Locale.Tr "hackforger.hackathon.register.display_name"}}</label>
					<input name="team_name" placeholder="{{ctx.Locale.Tr "hackforger.hackathon.register.display_name_hint"}}">
				</div>
				<button class="ui green button" type="submit">{{ctx.Locale.Tr "hackforger.hackathon.register"}}</button>
			</form>
		</div>
		{{end}}

		{{/* Already registered */}}
		{{if .IsRegistered}}
		<div class="ui positive message">{{svg "octicon-check" 16}} {{ctx.Locale.Tr "hackforger.hackathon.register.already_registered"}}</div>
		{{end}}

		{{/* Participants */}}
		{{if .Registrations}}
		<div class="ui segment">
			<h3>{{svg "octicon-people" 16}} {{ctx.Locale.Tr "hackforger.hackathon.view.participants"}} ({{.RegistrationCount}})</h3>
			<div class="ui divided list">
				{{range .Registrations}}
				<div class="item">
					<div class="content tw-flex tw-items-center tw-justify-between">
						<span>{{.TeamName}}</span>
						<span class="ui mini label {{if eq .Status 1}}green{{else if eq .Status 2}}red{{else}}yellow{{end}}">
							{{if eq .Status 0}}{{ctx.Locale.Tr "hackforger.hackathon.view.pending"}}
							{{else if eq .Status 1}}{{ctx.Locale.Tr "hackforger.hackathon.view.approved"}}
							{{else}}{{ctx.Locale.Tr "hackforger.hackathon.view.rejected"}}{{end}}
						</span>
					</div>
				</div>
				{{end}}
			</div>
		</div>
		{{end}}

		{{/* Submit button */}}
		{{if and (eq .Hackathon.Status 2) .IsRegistered}}
		<div class="tw-text-center tw-my-4">
			<a class="ui large primary button" href="{{AppSubUrl}}/hackathon/{{.Hackathon.Slug}}/submit">{{svg "octicon-upload" 16}} {{ctx.Locale.Tr "hackforger.hackathon.submit"}}</a>
		</div>
		{{end}}

		{{/* Submissions */}}
		{{if .Submissions}}
		<div class="ui segment">
			<h3>{{svg "octicon-project" 16}} {{ctx.Locale.Tr "hackforger.hackathon.view.submissions"}} ({{len .Submissions}})</h3>
			<table class="ui celled table">
				<thead><tr>
					<th>{{ctx.Locale.Tr "hackforger.hackathon.submit.field.title"}}</th>
					<th>{{ctx.Locale.Tr "hackforger.hackathon.submit.field.demo_url"}}</th>
					<th>{{ctx.Locale.Tr "hackforger.hackathon.view.pr"}}</th>
					<th>{{ctx.Locale.Tr "hackforger.hackathon.leaderboard.score"}}</th>
					<th>{{ctx.Locale.Tr "hackforger.hackathon.leaderboard.rank"}}</th>
				</tr></thead>
				<tbody>
					{{range .Submissions}}
					<tr {{if eq .Rank 1}}class="positive"{{end}}>
						<td>{{.Title}}</td>
						<td>{{if .DemoURL}}<a href="{{.DemoURL}}">Demo</a>{{end}}</td>
						<td>{{if .PullIndex}}<a href="{{AppSubUrl}}/{{$.LinkedOrg.Name}}/{{.TrackID}}/pulls/{{.PullIndex}}">PR #{{.PullIndex}}</a>{{else}}-{{end}}</td>
						<td>{{if gt .TotalScore 0.0}}{{printf "%.1f" .TotalScore}}{{else}}-{{end}}</td>
						<td>{{if gt .Rank 0}}#{{.Rank}}{{else}}-{{end}}</td>
					</tr>
					{{end}}
				</tbody>
			</table>
		</div>
		{{end}}

		{{/* Leaderboard link */}}
		{{if eq .Hackathon.Status 4}}
		<div class="tw-text-center tw-my-4">
			<a class="ui large button" href="{{AppSubUrl}}/hackathon/{{.Hackathon.Slug}}/leaderboard">{{svg "octicon-trophy" 16}} {{ctx.Locale.Tr "hackforger.hackathon.leaderboard"}}</a>
		</div>
		{{end}}
	</div>
</div>
{{template "base/footer" .}}
