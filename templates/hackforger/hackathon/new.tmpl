{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content hackathon">
	<div class="ui container">
		{{template "base/alert" .}}
		<h2>{{ctx.Locale.Tr "hackforger.hackathon.create"}}</h2>
		<div class="hf-card">
			<div class="hf-card-body">
				<form class="ui form" method="post" action="{{AppSubUrl}}/hackathons/new">
					<div class="required field">
						<label>{{ctx.Locale.Tr "hackforger.hackathon.field.name"}}</label>
						<input name="name" required placeholder="{{ctx.Locale.Tr "hackforger.hackathon.field.name_hint"}}">
					</div>
					<div class="required field">
						<label>{{ctx.Locale.Tr "hackforger.hackathon.field.slug"}}</label>
						<input name="slug" required pattern="[a-z0-9\-]+" placeholder="my-hackathon">
						<p class="help">{{ctx.Locale.Tr "hackforger.hackathon.field.slug_hint"}}</p>
					</div>
					<div class="field">
						<label>{{ctx.Locale.Tr "hackforger.hackathon.field.description"}}</label>
						{{template "shared/combomarkdowneditor" (dict
							"MarkdownPreviewUrl" (print AppSubUrl "/hackforger/markup")
							"MarkdownPreviewContext" ""
							"TextareaName" "description"
							"TextareaPlaceholder" (ctx.Locale.TrString "hackforger.hackathon.field.description_hint")
							"DropzoneParentContainer" "form"
						)}}
					</div>
					{{if .IsAttachmentEnabled}}
					<div class="field">
						{{template "repo/upload" .}}
					</div>
					{{end}}
					<div class="field">
						<label>{{ctx.Locale.Tr "hackforger.hackathon.field.prize_summary"}}</label>
						<textarea name="prize_summary" rows="3" placeholder="{{ctx.Locale.Tr "hackforger.hackathon.field.prize_hint"}}"></textarea>
						<p class="help">{{ctx.Locale.Tr "hackforger.hackathon.field.prize_markdown"}}</p>
					</div>

					<h4 class="tw-mt-4 tw-mb-2">{{ctx.Locale.Tr "hackforger.hackathon.field.settings"}}</h4>
					<div class="field">
						<label>{{ctx.Locale.Tr "hackforger.hackathon.field.max_team_size"}}</label>
						<input name="max_team_size" type="number" value="5" min="1">
					</div>

					<button class="hf-btn hf-btn-primary tw-mt-4" type="submit">{{ctx.Locale.Tr "hackforger.hackathon.create"}}</button>
				</form>
			</div>
		</div>
	</div>
</div>
{{template "base/footer" .}}
