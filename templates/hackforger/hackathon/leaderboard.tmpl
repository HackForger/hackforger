{{template "base/head" .}}
<div role="main" aria-label="{{.Title}}" class="page-content hackathon">
	<div class="ui container">
		<h2>{{ctx.Locale.Tr "hackforger.hackathon.leaderboard"}} — {{.Hackathon.Name}}</h2>

		{{if .Tracks}}
		{{/* Tab menu */}}
		<div class="ui top attached tabular menu">
			{{range $i, $t := .Tracks}}
			<a class="item {{if eq $i 0}}active{{end}}" data-tab="track-{{$t.ID}}">{{$t.Name}}</a>
			{{end}}
		</div>

		{{/* Tab content for each track */}}
		{{range $i, $t := .Tracks}}
		<div class="ui bottom attached tab segment {{if eq $i 0}}active{{end}}" data-tab="track-{{$t.ID}}">
			{{$subs := index $.SubsByTrack $t.ID}}
			{{$rubric := index $.Rubrics $t.ID}}
			{{if $subs}}
			<table class="ui celled table">
				<thead>
					<tr>
						<th>{{ctx.Locale.Tr "hackforger.hackathon.leaderboard.rank"}}</th>
						<th>{{ctx.Locale.Tr "hackforger.hackathon.leaderboard.team"}}</th>
						{{if $.ShowBreakdown}}
							{{range $rubric}}
							<th>{{.Name}}</th>
							{{end}}
						{{end}}
						<th>{{if $.ShowBreakdown}}{{ctx.Locale.Tr "hackforger.hackathon.leaderboard.weighted_total"}}{{else}}{{ctx.Locale.Tr "hackforger.hackathon.leaderboard.score"}}{{end}}</th>
					</tr>
				</thead>
				<tbody>
					{{range $subs}}
					<tr {{if eq .Rank 1}}class="positive"{{else if and (ge .Rank 2) (le .Rank 3)}}class="warning"{{end}}>
						<td>#{{.Rank}}</td>
						<td>{{.Title}}{{if .DemoURL}} — <a href="{{.DemoURL}}">Demo</a>{{end}}</td>
						{{if $.ShowBreakdown}}
							{{range $rubric}}
							<td>-</td>
							{{end}}
						{{end}}
						<td>{{printf "%.1f" .TotalScore}}</td>
					</tr>
					{{end}}
				</tbody>
			</table>
			{{else}}
			<div class="ui info message">{{ctx.Locale.Tr "hackforger.hackathon.judge.no_submissions"}}</div>
			{{end}}
		</div>
		{{end}}

		{{else}}
		<div class="ui info message">{{ctx.Locale.Tr "hackforger.hackathon.judge.no_submissions"}}</div>
		{{end}}
	</div>
</div>
{{template "base/footer" .}}
