	tls {
		dns alidns {
			access_key_id {env.ALIDNS_ACCESS_KEY_ID}
			access_key_secret {env.ALIDNS_ACCESS_KEY_SECRET}
		}
	}

	@hackforger host hackforger.inside.h2os.cloud
	handle @hackforger {
		reverse_proxy host.docker.internal:3000
	}

